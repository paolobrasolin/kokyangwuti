{
  "name": "kokyangwuti",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "check": "biome check --write",
    "dev": "rsbuild dev --open",
    "format": "biome format --write",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:slow": "rstest run -c rstest.slow.config.ts",
    "test:watch": "rstest --watch",
    "bench": "rstest run --include 'bench/**/*.bench.ts' --testTimeout 600000 --disableConsoleIntercept",
    "headless": "node --import ./bench/register.mjs bench/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@rsbuild/core": "^1.6.14",
    "@rstest/core": "^0.7.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3"
  },
  "supportedArchitectures": {
    "os": [
      "darwin",
      "linux"
    ],
    "cpu": [
      "arm64",
      "x64"
    ]
  }
}
